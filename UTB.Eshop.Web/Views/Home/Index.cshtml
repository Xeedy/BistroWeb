@model CarouselProductViewModel
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/1.20.6/TweenMax.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.11.2/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<!-- Slick Slider CSS -->
<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css" />
<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick-theme.css" />

<!-- Slick Slider JS -->
<script src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>



@{
    ViewData["Title"] = "Home Page";
    ViewBag.ShowCarousel = true; // Zobrazit carousel
}

@section Carousel {
    <div id="carouselExampleControls" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            @for (int i = 0; i < Model.Carousels.Count; ++i)
            {
                string active = (i == 0) ? "active" : "";
                <div class="carousel-item @active">
                    <img src="@Model.Carousels[i].ImageSrc" class="d-block w-100" alt="@Model.Carousels[i].ImageAlt" />
                    <div class="carousel-caption d-none d-md-block custom-caption">
                        <h5>@Model.Carousels[i].CaptionTitle</h5>
                        <p>@Model.Carousels[i].CaptionText</p>
                    </div>
                </div>
            }
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleControls" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleControls" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
}


<!-- Zde může být zbytek obsahu stránky -->
<div class="wtextcontainer mt-3">
    <div class="row">
        <!-- Column for text -->
        <div class="col-md-8 order-md-1">
            <div class="beercontainer">
                <h1>Vítejte v naší pivotéce</h1>
                <p>
                    Ne nadarmo s říká o Stars Hollow že je duchovní oáza (nejen) pivních fajnšmekrů!
                    Myšlenkovou předlohou našeho bistra je oblíbené Lukovo bistro z ještě oblíbenějšího seriálu Gilmorova děvčata.
                    V rozporu s dobou, se vší pokorou a pečlivostí bdíme nad tím, aby forma neměla navrch před obsahem.
                    Nemíníme se Vám proto podbízet okázalými designovými, gastronomickými ani žádnými jinými trendy a věcmi, které by ve Vás mohly vyvolat pocit,
                    že jste a jsme lepší nebo horší, než ve skutečnosti jste a jsme.
                    Jsme obyčejné místo, kde se schází různé generace, různé honorace, popíci i metly, flinkové i floutci, oni i ony, Brandonové i Dony,
                    milující i milovaní, malí i velcí….výškou i vědomím….ale ať už se cítíte blbě nebo dobře,
                    tak věřte, že zde bude vždy ještě minimálně o stupeň lépe….někdy i o 11 stupňů z Humpolce!

                    Jsme totiž obyčejné místo - s pečlivě vybranou, krásnou hudbou, nekonvenční nabídkou, osobitou atmosférou a věčně zamračenou obsluhou -
                    prostě ostrůvek úsměvně švihlé pohody v moři každodenní uspěchanosti!
                </p>
            </div>
        </div>
        <!-- Column for Facebook widget -->
        <div class="col-md-4 order-md-0">
            <div class="facebook-container">
                <div class="fb-page" data-href="https://www.facebook.com/bistroStarsHollow"
                     data-show-posts="true" data-width="350" data-height="500" data-small-header="false"
                     data-adapt-container-width="true" data-hide-cover="false" data-show-facepile="true">
                    <blockquote cite="https://www.facebook.com/bistroStarsHollow" class="fb-xfbml-parse-ignore">
                        <a href="https://www.facebook.com/bistroStarsHollow">Pivotéka a Bistro Stars Hollow</a>
                    </blockquote>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="container mt-5">
    <div class="row">
        @if (Model.Tapeeds != null && Model.Tapeeds.Any())
        {
            @foreach (var tapped in Model.Tapeeds.Where(p => p.Active))
            {
                <div class="col-md-3 mb-4">
                    <div class="card">
                        <!-- Card content -->
                        <div class="card-body d-flex flex-column align-items-center">
                            <img class="img-fluid mb-3 brewery-image" src="@tapped.Breweries.ImageSrc" alt="Brewery Image" />
                            <!-- Card title -->
                            <h5 class="card-title"><strong>@tapped.Name</strong></h5>
                            <!-- Beer Price -->
                            <p class="card-text">0,5l: @tapped.MainPrice,-</p>
                            <p class="card-text">0,3l: @tapped.OtherPrice,-</p>
                            <!-- Brewery -->
                            <p class="card-text">Pivovar: @tapped.Breweries.Name</p>
                            <!-- Type of beer -->
                            <p class="card-text">Typ: @tapped.Typees.Name</p>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-md-12">
                <p>No tapped beers available</p>
            </div>
        }
    </div>
</div>
<div class="container mt-5>
    <div class="row">
        <!-- Left Column for Beers List -->
        <div class="col-md-8">
            @if (Model.Tapeeds != null && Model.Tapeeds.Any())
            {
                @foreach (var tapped in Model.Tapeeds.Where(p => p.Active).Take(5))
                {
                    <div class="beer-item mb-4 d-flex align-items-center">
                        <div class="beer-image">
                            <img class="img-fluid" src="@tapped.Breweries.ImageSrc" alt="Brewery Image" style="width: 100px; height: 100px;" />
                        </div>
                        <div class="beer-details ms-3">
                            <!-- Beer Name -->
                            <h5 class="mb-1"><strong>@tapped.Name</strong></h5>
                            <!-- Beer Price -->
                            <p class="mb-1">0,5l: @tapped.MainPrice,- | 0,3l: @tapped.OtherPrice,-</p>
                            <!-- Brewery Name -->
                            <p class="mb-1">Pivovar: @tapped.Breweries.Name</p>
                            <!-- Beer Type -->
                            <p class="mb-1">Typ: @tapped.Typees.Name</p>
                        </div>
                    </div>
                    <hr />
                }
            }
            else
            {
                <div class="col-md-12">
                    <p>Bohužel žádná piva k zobrazení</p>
                </div>
            }
        </div>
        <!-- Right Column for Facebook widget -->
        <div class="col-md-4 d-flex flex-column">
            <div class="facebook-container flex-grow-1">
                <div class="fb-page" data-href="https://www.facebook.com/bistroStarsHollow"
                     data-show-posts="true" data-width="350" data-small-header="false"
                     data-adapt-container-width="true" data-hide-cover="false" data-show-facepile="true">
                    <blockquote cite="https://www.facebook.com/bistroStarsHollow" class="fb-xfbml-parse-ignore">
                        <a href="https://www.facebook.com/bistroStarsHollow">Pivotéka a Bistro Stars Hollow</a>
                    </blockquote>
                </div>
            </div>
        </div>

    </div>
</div>
<div class="container mt-3">
    <div class="wtextcontainer">
        <div class="Infinite">
            <div class="Infinite-inner">
                <div class="cardInfinite">Card 1</div>
                <div class="cardInfinite">Card 2</div>
                <div class="cardInfinite">Card 3</div>
                <div class="cardInfinite">Card 4</div>
                <div class="cardInfinite">Card 5</div>
                <div class="cardInfinite">Card 6</div>
                <div class="cardInfinite">Card 1</div>
                <div class="cardInfinite">Card 2</div>
                <div class="cardInfinite">Card 3</div>
            </div>
            <button class="arrow left" onclick="showPrevious()">&#9664;</button>
            <button class="arrow right" onclick="showNext()">&#9654;</button>
        </div>
    </div>
</div>




@section Styles
    {
    <!-- Include Card.css -->
    <link rel="stylesheet" href="~/css/Index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/CardBrewery.css" asp-append-version="true" />
    }

@section Scripts {
    <script async defer crossorigin="anonymous" src="https://connect.facebook.net/cs_CZ/sdk.js#xfbml=1&version=v19.0" nonce="m5EPqYPG"></script>
    <script src="~/js/CardBrewery.js" asp-append-version="true"></script>
    <script>
        let currentIndex = 0;
        const totalCards = 9; // Total number of cards

        function showNext() {
            currentIndex += 1; // Move to the next card
            if (currentIndex > totalCards - 3) {
                currentIndex = totalCards - 3; // Prevent going past the last set
            }
            updateCarousel();
        }

        function showPrevious() {
            currentIndex -= 1; // Move to the previous card
            if (currentIndex < 0) {
                currentIndex = 0; // Prevent going before the first card
            }
            updateCarousel();
        }

        function updateCarousel() {
            const offset = -currentIndex * (100 / 3);
            document.querySelector('.Infinite-inner').style.transform = `translateX(${offset}%)`;
        }
    </script>
}
